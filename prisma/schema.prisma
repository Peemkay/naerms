// NAERMS — Nigerian Army Signals Equipment Returns Management System
// Prisma schema: formation tree (formations ARE the accounts), privilege-based
// access, multi-equipment return requests, subtree notifications.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// FORMATION TREE — also the account model. There is no separate User:
// a formation logs in directly (email + password) once someone with
// MANAGE_ACCOUNTS privilege sets that up for it. A formation can exist
// as a pure org-chart node with no login at all.
// ---------------------------------------------------------------------

enum FormationType {
  ROOT              // NAS (Nigerian Army Signals) — top of the tree
  COMMAND           // e.g. NACWC
  SCHOOL
  SIGNAL_BRIGADE    // e.g. 52 Signals Brigade
  SIGNAL_REGIMENT   // SR — sits directly under a Signal Brigade (e.g. 520 SR, 525 SR)
  BRIGADE_SIGNALS   // BS — administratively under NAS, but supports another corps' brigade (e.g. 521 BS)
  UNIT              // lowest level — where returns are actually submitted
}

enum FormationRole {
  OPERATIONAL   // e.g. 520 SR — field comms
  SUPPORT       // e.g. 525 SR — maintenance, workshops, supply
  ATTACHED      // e.g. 521 BS — detached to support another corps brigade
}

// Individually-grantable capabilities, replacing a fixed role hierarchy.
// A formation can hold any combination. Granting one requires the granter
// to (a) hold MANAGE_PRIVILEGES itself and (b) already hold the specific
// privilege being granted — see src/lib/privileges.ts.
enum Privilege {
  MANAGE_FORMATIONS   // create new formations in the tree
  MANAGE_ACCOUNTS     // set up / reset another formation's login
  MANAGE_PRIVILEGES   // grant or revoke privileges on another formation
  VERIFY_RETURNS      // move a return item through the workflow (verify/flag/close/etc.)
  DELETE_RETURNS      // permanently erase a return — separate from VERIFY_RETURNS since
                      // verifying is routine workflow, deleting is irreversible cleanup
}

model Formation {
  id            String        @id @default(cuid())
  name          String                          // e.g. "521 Brigade Signals"
  type          FormationType
  role          FormationRole?                   // relevant for SR / BS, optional elsewhere

  // NAS chain of command — every formation's real reporting line stays pure NAS
  parentId      String?
  parent        Formation?    @relation("FormationTree", fields: [parentId], references: [id])
  children      Formation[]   @relation("FormationTree")

  // For BS units only: the external corps brigade they support operationally.
  // Kept separate from parentId — attachment is NOT a chain-of-command change.
  attachedTo    String?                          // e.g. "4 Mechanised Infantry Brigade"

  // --- Account (nullable — a formation may have no login yet) ----------
  email               String?     @unique         // login address, e.g. "521.bs@army.mil.ng"
  passwordHash        String?
  isActive            Boolean     @default(true)
  privileges          Privilege[]

  // Brute-force lockout: incremented on each failed login, reset on success.
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?

  returns             Return[]
  statusChanges       StatusHistory[]
  notifications       Notification[]
  requestsSent        ReturnRequest[] @relation("RequestsSent")
  requestsReceived    ReturnRequest[] @relation("RequestsReceived")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([parentId])
}

// ---------------------------------------------------------------------
// RETURNS — one Return is one register submission (one Request Ref),
// which can bundle multiple equipment items.
// ---------------------------------------------------------------------

// Workflow status — where a return item is in the review/approval chain
enum ReturnStatus {
  PENDING       // submitted, awaiting verification
  VERIFIED      // confirmed accurate by next level up
  DISCREPANCY   // flagged — mismatch or missing info
  RETURNED      // equipment physically returned
  CLOSED        // fully reconciled
}

// Equipment condition — independent of workflow status. A radio can be
// UNSERVICEABLE and still PENDING verification at the same time. Kept as a
// standalone enum (used to type the per-condition quantity breakdown below
// and in application code) even though it no longer backs a single column.
enum EquipmentCondition {
  SERVICEABLE
  UNSERVICEABLE
  UNDER_REPAIR
  AWAITING_EVACUATION
}

model Return {
  id               String        @id @default(cuid())
  requestRef       String                           // Request Ref — shared by every item below
  auth             String?                          // Auth
  formationId      String                           // Fmn/Unit submitting
  formation        Formation     @relation(fields: [formationId], references: [id])

  items            ReturnItem[]
  notifications    Notification[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([formationId])
}

// One physical equipment line within a Return. What used to be the whole
// "EquipmentReturn" row is now one of these — a Return is the register
// entry, a ReturnItem is one equipment line on it. Date issued / deployment
// mode / purpose live here rather than on Return, since different items in
// the same request can genuinely have been issued on different dates for
// different purposes.
model ReturnItem {
  id               String        @id @default(cuid())
  returnId         String
  return           Return        @relation(fields: [returnId], references: [id], onDelete: Cascade)
  lineNo           Int                              // position within the request (1, 2, 3…)

  dateIssued       DateTime?
  howDeployed      String?                          // How Depl
  purposeOfIssue   String?

  equipmentName    String
  equipmentModel   String?
  band             String?
  equipmentType    String?
  origin           String?

  status           ReturnStatus         @default(PENDING)      // workflow state

  // Physical/serviceability state, as a breakdown across however many units
  // of this equipment are in possession — not a single condition. The form
  // offers an "all in one condition" shortcut that just fills one bucket.
  quantity              Int              @default(1)
  serviceableQty        Int              @default(0)
  unserviceableQty      Int              @default(0)
  underRepairQty        Int              @default(0)
  awaitingEvacuationQty Int              @default(0)

  remarks          String?

  statusHistory    StatusHistory[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([returnId])
  @@index([status])
}

// Full audit trail — required for command-level accountability
model StatusHistory {
  id           String           @id @default(cuid())
  returnItemId String
  returnItem   ReturnItem       @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  changedById  String
  changedBy    Formation        @relation(fields: [changedById], references: [id])
  fromStatus   ReturnStatus?
  toStatus     ReturnStatus
  note         String?
  changedAt    DateTime         @default(now())

  @@index([returnItemId])
}

// ---------------------------------------------------------------------
// RETURN REQUESTS — any formation can ask any formation under it (anywhere
// in its own subtree, not just direct children) to submit a return. This is
// the inverse direction of a Return's own notification fan-out: a Return
// notifies downward from wherever it was *submitted*; a ReturnRequest
// notifies downward from wherever it was *asked for*. See
// src/lib/actions/return-requests.ts.
// ---------------------------------------------------------------------

model ReturnRequest {
  id              String     @id @default(cuid())
  requestRef      String                              // reference for the ask itself
  message         String?
  fromFormationId String
  fromFormation   Formation  @relation("RequestsSent", fields: [fromFormationId], references: [id])
  toFormationId   String
  toFormation     Formation  @relation("RequestsReceived", fields: [toFormationId], references: [id])
  createdAt       DateTime   @default(now())

  notifications   Notification[]

  @@index([toFormationId])
  @@index([fromFormationId])
}

// ---------------------------------------------------------------------
// NOTIFICATIONS — three triggers: submitting a Return notifies every
// formation in the submitter's own subtree (RETURN_SUBMITTED); requesting a
// return notifies the asked formation's *entire* subtree, same fan-out
// shape as a submission (RETURN_REQUESTED); submitting a Return whose
// requestRef answers an open ReturnRequest additionally notifies every
// formation up the submitter's chain of command — everyone who could see
// the original ask — that it's been answered (RETURN_REQUEST_FULFILLED).
// Exactly one of returnId/requestId is set, matching `type` (fulfilled sets
// both: the return that answers, the request it answers).
// ---------------------------------------------------------------------

enum NotificationType {
  RETURN_SUBMITTED
  RETURN_REQUESTED
  RETURN_REQUEST_FULFILLED
}

model Notification {
  id           String            @id @default(cuid())
  formationId  String                                 // recipient
  formation    Formation         @relation(fields: [formationId], references: [id])
  type         NotificationType  @default(RETURN_SUBMITTED)
  returnId     String?
  return       Return?           @relation(fields: [returnId], references: [id], onDelete: Cascade)
  requestId    String?
  request      ReturnRequest?    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message      String
  isRead       Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@index([formationId, isRead])
}
